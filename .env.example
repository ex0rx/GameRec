POSTGRES_USER=gamerec
POSTGRES_PASSWORD=
POSTGRES_DB=gamerec

STEAM_API_KEY=
# Optional local verification account; never put this in frontend VITE_* settings.
STEAMID64_TEST=
# Manual sync is restricted to this one valid 17-digit account in development.
ENVIRONMENT=development
MANUAL_LIBRARY_SYNC_ENABLED=false
MANUAL_LIBRARY_SYNC_COOLDOWN_SECONDS=60
# Independent of manual sync; same development test-account restriction.
USER_PREFERENCE_WRITES_ENABLED=false

DATABASE_URL=
EMBEDDING_SERVICE_URL=http://embeddings:8100

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_GENERATION_TIMEOUT=180

REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=0.1
EXPLANATION_CACHE_ENABLED=true
EXPLANATION_CACHE_TTL_SECONDS=3600
EXPLANATION_CACHE_VERSION=v1

# Steam authentication is independent of library/preference write allowlists.
AUTH_ENABLED=false
AUTH_PUBLIC_BASE_URL=http://localhost:5173/api
AUTH_FRONTEND_ORIGIN=http://localhost:5173
AUTH_SUCCESS_PATH=/discover
AUTH_SESSION_TTL_SECONDS=604800
AUTH_LOGIN_TTL_SECONDS=600
# Explicit local HTTP override only. HTTPS/production requires true (code default).
AUTH_COOKIE_SECURE=false
# Base names: HTTPS automatically adds __Host- and always uses Path=/.
AUTH_SESSION_COOKIE_NAME=gamerec_session
AUTH_LOGIN_COOKIE_NAME=gamerec_login
